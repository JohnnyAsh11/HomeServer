
@inject NavigationManager Navigation

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assistant">AI</MudNavLink>
    <MudNavLink Href="TodoList" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Checklist">Task Tracker</MudNavLink>
    <MudNavLink Href="/api/hangfire" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Pattern">Hangfire</MudNavLink>
    <MudNavLink Href="https://racinggods.live" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SportsMotorsports">RacingGods</MudNavLink>
    <MudNavLink Href="@FinanceUrl" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AttachMoney">Finances</MudNavLink>
    <MudNavLink Href="index.html" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.MenuBook">API Docs</MudNavLink>
    <MudNavLink Href="@TraefikUrl" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Traffic">Traefik</MudNavLink>
</MudNavMenu>

@code {
    private string FinanceUrl
    {
        get
        {
            UriBuilder uriBuilder = new(Navigation.BaseUri)
            {
                Scheme = Uri.UriSchemeHttp,
                Port = 5006,
                Path = "/"
            };

            return uriBuilder.Uri.AbsoluteUri;
        }
    }

    private string TraefikUrl
    {
        get
        {
            UriBuilder uriBuilder = new(Navigation.BaseUri)
            {
                Scheme = Uri.UriSchemeHttp,
                Port = 8080,
                Path = "/"
            };

            return uriBuilder.Uri.AbsoluteUri;
        }
    }
}
