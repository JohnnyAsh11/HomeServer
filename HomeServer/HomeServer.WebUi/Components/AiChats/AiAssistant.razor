@page "/"
@inject HomeServerClient Client;
@inject IDialogService DialogService;
@inject ISnackbar Snackbar;
@inject ILogger<AiAssistant> Logger;
@implements IAsyncDisposable

<PageTitle>AI Assistant</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper>
            @* Header for the AI assistant page *@
            <MudText style="margin: 30px; font-size: 2rem;"
                        Class="pa-4">
                AI Assistant
            </MudText>

            @* Readies a new chat for the user to send messages to the AI assistant. *@
            <MudButton style="margin: 30px;"
                        Class="pa-4"
                        StartIcon="@Icons.Material.Filled.Add"
                        Variant="Variant.Outlined"
                        aria-label="select"
                        OnClick="() => CreateNewChat()"
                        Color="Color.Success">
                Start New Chat
            </MudButton>

            @* Opens a dialog to show the user all of their deleted chats. *@
            <MudButton style="margin: 30px;"
                        Class="pa-4"
                        StartIcon="@Icons.Material.Filled.Folder"
                        Variant="Variant.Outlined"
                        aria-label="select"
                        OnClick="() => ViewArchive()"
                        Color="Color.Secondary">
                Archive
            </MudButton>
        </MudPaper>
    </MudItem>

    @* Displays all of the past chats. *@
    <MudItem xs="3">
        <MudDataGrid T="ChatModel" Items="_chats" Loading="false">
            <Columns>
                <PropertyColumn Property="x => x.Id" Title="Id" HeaderStyle="width:25px" />
                <PropertyColumn Property="x => x.Title" Title="Title" HeaderStyle="width:200px" />
                <PropertyColumn Property="x => x.Title" Title="Select" HeaderStyle="width:50px">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                       aria-label="select"
                                       OnClick="() => SelectChat(context.Item.Id)"
                                       Disabled="context.Item.IsSelected"
                                       Color="Color.Primary" />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.IsDeleted" Title="Delete" HeaderStyle="width:50px" >
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" 
                                       aria-label="delete" 
                                       OnClick="() => DeleteChat(context.Item.Id)"
                                       Color="Color.Error" />
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </MudItem>
    
    <MudItem xs="9">
        <MudGrid>
            @* The chat view area. *@
            <MudItem xs="12">
                <MudTable T="string" Items="@_messages" Hover="true" Breakpoint="Breakpoint.Sm">
                    <RowTemplate>
                        <MudTd DataLabel="Messages">@context</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            @* The message entry field. *@
            <MudItem xs="12">
                <MudTextField @bind-Value="Prompt" 
                    Label="Prompt" 
                    Variant="Variant.Outlined" 
                    InputType="@TextInput"
                    Adornment="Adornment.End" 
                    AdornmentIcon="@Icons.Material.Filled.ArrowForward"
                    OnAdornmentClick="PostMessageToChat"
                    AdornmentAriaLabel="Send Prompt" />
            </MudItem>
        </MudGrid>
    </MudItem>

</MudGrid>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);
    private readonly CancellationTokenSource _refreshCancellation = new();
    private Task? _refreshTask;

    private const InputType TextInput = InputType.Text;
    private IEnumerable<ChatModel> _chats = [];
    private IEnumerable<string> _messages = [];
    private ChatModel? selectedChat = null;

    /// <summary>
    /// User entered prompt to send to AI assistant.
    /// </summary>
    public string Prompt { get; set; } = string.Empty;

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        await ReloadDataAsync();
    }

    /// <inheritdoc/>
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _refreshTask = RefreshDataPeriodicallyAsync(_refreshCancellation.Token);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Disposes of the resources used by the component.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _refreshCancellation.Cancel();

        if (_refreshTask is not null)
        {
            await _refreshTask;
        }

        _refreshCancellation.Dispose();
    }

    /// <summary>
    /// Refreshes the data in the tables periodically.
    /// </summary>
    private async Task RefreshDataPeriodicallyAsync(CancellationToken cancellationToken)
    {
        // Refresh the data every X seconds until the component is disposed.
        using PeriodicTimer timer = new(RefreshInterval);

        try
        {
            // Keep refreshing until the component is disposed.
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                // Refresh the data in the tables.
                await InvokeAsync(async () =>
                {
                    // Reloading the data and letting the UI know that the data has changed.
                    await ReloadDataAsync();
                    StateHasChanged();
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Data refresh was canceled.");
        }
    }

    /// <summary>
    /// Reloads the data in tables from the API.
    /// </summary>
    private async Task ReloadDataAsync()
    {
        // Getting all of the chats.
        ICollection<ChatInfoDto> chatData = await Client.Chat.GetAiChatsAsync();

        // Converting them to the view model & ensuring no deleted chats are displayed.
        _chats = chatData
            .Select(chat => ToViewModel(chat))
            .Where(chat => !chat.IsDeleted);

        // Maintain the same selected chat.
        ChatModel? selected = _chats.FirstOrDefault(chat => chat.Id == selectedChat?.Id);
        if (selected is null)
        {
            _messages = [];
            return;
        }

        selectedChat = selected;
        ChatContentDto chatContent = await Client.Chat.GetAiChatByIdAsync(selectedChat.Id);

        if (chatContent.Messages is null)
        {
            _messages = [];
            return;
        }

        _messages = chatContent.Messages
            .Where(content => content.UserRole != 0)
            .Select(content => content.Message ?? string.Empty);
    }

    /// <summary>
    /// Callback for chat deletion button.
    /// </summary>
    private async Task DeleteChat(int id)
    {
        // TODO: Handle gracefully it deleted chat is selected chat.
        await Client.Chat.DeleteAiChatByIdAsync(id);
        await ReloadDataAsync();
    }

    /// <summary>
    /// Callback for Chat selection button.
    /// </summary>
    private async Task SelectChat(int id)
    {
        // Getting the target chat.
        ChatModel? chat = _chats.FirstOrDefault(chat => chat.Id == id);
        if (chat is null)
        {
            Logger.LogWarning("Could not find/select chat with ID: {id}", id);
            return;
        }

        // Unselect all chats.
        foreach (ChatModel model in _chats)
        {
            model.IsSelected = false;
        }

        // Select the target chat.
        chat.IsSelected = true;
        selectedChat = chat;
        await ReloadDataAsync();
    }

    /// <summary>
    /// Will post a message to a selected chat or create a new chat if none is selected.
    /// </summary>
    private async Task PostMessageToChat()
    {
        if (selectedChat is null)
        {
            // This is a new chat, create a new chat.
            ChatInfoDto newChatDto = new()
            {
                FirstMessage = Prompt
            };

            int respId;
            try
            {
                // Creating the chat.
                respId = await Client.Chat.PostAiChatAsync(newChatDto);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error sending message to chat.");
                Snackbar.Add("Failed to send message.", Severity.Error);
                return;
            }

            // Reload the list before looking up the newly created chat.
            await ReloadDataAsync();
            ChatModel? newChat = _chats.FirstOrDefault(chat => chat.Id == respId);
            if (newChat is null)
            {
                Logger.LogWarning("Unable to find newly posted chat.");
                Snackbar.Add("Chat was created, but could not be loaded.", Severity.Error);
                return;
            }

            Snackbar.Add("Message sent successfully.", Severity.Success);

            // Selecting the new chat.
            newChat.IsSelected = true;
            selectedChat = newChat;
            Prompt = string.Empty;
            await ReloadDataAsync();
        }
        else
        {
            // If not a new chat, post the message to the chat.
            MessageContentDto dto = new()
            {
                Id = selectedChat.Id,
                Message = Prompt,
                Timestamp = DateTime.Now.ToString(),
                UserRole = 1 // Assuming 1 represents the user role.
            };

            try
            {
                await Client.Chat.PostMessageToAiChatByIdAsync(selectedChat.Id, dto);
                Prompt = string.Empty;
                Snackbar.Add("Message sent successfully.", Severity.Success);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error sending message to chat.");
                Snackbar.Add("Failed to send message.", Severity.Error);
            }

            await ReloadDataAsync();
        }
    }

    /// <summary>
    /// Callback for creating a new chat.
    /// Really just deselects all chats and clears the message list.
    /// </summary>
    private async Task CreateNewChat()
    {
        selectedChat = null;
        _messages = [];

        foreach(ChatModel chat in _chats)
        {
            chat.IsSelected = false;
        }
    }

    /// <summary>
    /// Callback for Archive button to view deleted chats.
    /// </summary>
    private async Task ViewArchive()
    {
        ICollection<ChatInfoDto> chatData = await Client.Chat.GetAiChatsAsync();
        List<ChatModel> deletedChats = chatData
            .Where(chat => chat.IsDeleted == true)
            .Select(chat => ToViewModel(chat))
            .ToList();

        DialogOptions options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true
        };

        DialogParameters parameters = new()
        {
            { "Chats", deletedChats }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ArchiveDialog>(
            "Chat Archive", 
            parameters, 
            options);

        DialogResult? result = await dialog.Result;
    }

    /// <summary>
    /// Converts dtos to view models.
    /// </summary>
    public ChatModel ToViewModel(ChatInfoDto dto)
    {
        return new ChatModel(
            dto.Id ?? 0,
            dto.Title ?? string.Empty,
            dto.IsDeleted ?? true,
            false);
    }
}
