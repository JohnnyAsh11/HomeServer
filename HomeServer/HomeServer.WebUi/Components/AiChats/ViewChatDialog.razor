<MudDialog>
    <DialogContent>
        <MudTable T="MessageModel" Items="@Messages" Hover="true" Breakpoint="Breakpoint.Sm">
            <RowTemplate>
                <MudTd Style="@(context.UserRole == 1 ? "text-align: right;" : "text-align: left;")"
                       DataLabel="Messages">@context.Message</MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public List<MessageModel> Messages { get; set; } = [];
}
